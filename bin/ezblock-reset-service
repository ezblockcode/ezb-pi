#!/usr/bin/python3

import sys
import time
import gpiozero

#
# =================================================================
RST_BTN_PIN = 16
USER_BTN_PIN = 25

# utils
# =================================================================
def log(msg:str=None,level='RESET-SERVICE',end='\n',flush=False,timestamp=True):
    with open('/opt/ezblock/log','a+') as log_file:
        if timestamp == True:
            _time = time.strftime("%y/%m/%d %H:%M:%S", time.localtime())
            ct = time.time()
            _msecs = '%03d '%((ct - int(ct)) * 1000)
            print('%s,%s[%s] %s'%(_time,_msecs,level,msg), end=end, flush=flush, file=log_file)
            print('%s,%s[%s] %s'%(_time,_msecs,level,msg), end=end, flush=flush, file=sys.stdout)
        else:
            print('%s'%msg, end=end, flush=flush, file=log_file)
            print('%s'%msg, end=end, flush=flush, file=sys.stdout)

def run_command(cmd=""):
    import subprocess
    p = subprocess.Popen(
        cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    result = p.stdout.read().decode('utf-8')
    status = p.poll()
    return status, result

#
# =================================================================
def resize_filesystem():
    RESIZE_SCRIPT = "/usr/bin/resize_once"
    
    log("Check resize script")
    
    _, result = run_command(f"ls {RESIZE_SCRIPT}")
    if result != "":
        log("Resizing rootfs ...")
        _, result = run_command(f"{RESIZE_SCRIPT}")
        log(f"\n{result}")
        run_command(f"rm {RESIZE_SCRIPT}")
    else:
        log("Skipping resize rootfs.")


def restart_ezblock():
    log("restart ezblock service")
    run_command("sudo service ezblock restart")

def reset_mcu():
    from ezblock import reset_mcu
    reset_mcu()

def reset_servos():
    from ezblock import Servo, PWM

    log("reset servos")
    for i in range(12):
        servo = Servo(PWM(i))
        servo.angle(10)
        time.sleep(0.1)
        servo.angle(0)
        time.sleep(0.1)

def stop_motors():
    from ezblock import PWM

    log("stop motors")
    PWM(12).pulse_width_percent(0)
    PWM(13).pulse_width_percent(0)

def is_user_pressed():
    run_command(f"pinctrl set {USER_BTN_PIN} ip pu ") # input, pull-up
    _, result = run_command(f"pinctrl get {USER_BTN_PIN} |grep ip |grep lo") # low-level means pressed
    return (result != "") # 

# main
# =================================================================
def main():

    log("ezblock-reset-service start ...")

    resize_filesystem()

    mode = 0

    rst_btn = gpiozero.InputDevice(RST_BTN_PIN, pull_up=True) # RST_BTN_PIN, pull_up -> low level -> value is 1
    # usr_btn = gpiozero.InputDevice(USER_BTN_PIN, pull_up=True)

    while True:
        try:
            # --- check btns ----
            mode = 0
            if rst_btn.value == 1: # 
                time.sleep(0.02) # anti-shake
                if rst_btn.value == 1:
                    mode = 1
                    if is_user_pressed():
                        time.sleep(0.02) # anti-shake
                        if is_user_pressed:
                            mode = 2
            
            # --- restart_ezblock ---
            if mode == 1:
                restart_ezblock()
                time.sleep(2)

            # --- reseting servos and reseting motors ---
            elif mode == 2:
                reset_mcu()
                time.sleep(0.2)
                stop_motors()
                reset_servos()
                time.sleep(2)

            # --- wait for RST btn release ---
            while rst_btn.value == 1:
                time.sleep(.02)

        except OSError:
            log("OSError")
            time.sleep(1)
        except Exception as e:
            log("error: %s"%e)
            time.sleep(1)

        # --- loop interval ---
        time.sleep(.01)


if __name__ == "__main__":
    main()

